{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "auth-policy",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "wallet-route": {
        "ClusterId": "wallet-cluster",
        "RateLimiterPolicy": "general-policy",
        "Match": {
          "Path": "/api/wallets/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-service": {
            "Address": "http://localhost:5248"
          }
        }
      },
      "wallet-cluster": {
        "Destinations": {
          "wallet-service": {
            "Address": "http://localhost:5249"
          }
        }
      }
    }
  }
}
